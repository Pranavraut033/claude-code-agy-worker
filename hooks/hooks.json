{
  "description": "delegate: enforce a worker subagent's job scope (allowed files, exact commands, protected files)",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": ["${CLAUDE_PLUGIN_ROOT}/server/guard_hook.py"],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
